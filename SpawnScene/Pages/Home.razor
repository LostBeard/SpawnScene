@page "/"

<PageTitle>SpawnScene — Step Into Your Photos</PageTitle>

<div class="page-wrapper">
    <div class="hero animate-in">
        <h1 class="hero-title">SpawnScene</h1>
        <p class="hero-subtitle" style="font-size: var(--font-size-lg); max-width: 700px;">
            Turn your photos into a 3D scene you can walk through.
            Everything runs on your GPU, in your browser: no servers, no uploads.
        </p>
        <p style="color: var(--text-muted); max-width: 600px; margin-top: var(--space-sm); line-height: 1.6;">
            Add a set of overlapping photos of a place: SpawnScene finds where each one was taken and trains a
            Gaussian splat scene against them. A single photo works too, as a depth-based scene.
            Explore the result in 3D on your desktop, or in WebXR VR and AR on supported devices.
        </p>
        <div style="margin-top: var(--space-xl); display: flex; gap: var(--space-md); flex-wrap: wrap; align-items: center;">
            <a href="studio" class="btn btn-primary" style="font-size: var(--font-size-lg); padding: var(--space-md) var(--space-xl);">
                Enter Studio
            </a>
            <a href="https://github.com/LostBeard/SpawnScene" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
                <svg style="width:1em;height:1em;vertical-align:middle;margin-right:0.4em" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38
                             0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13
                             -.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66
                             .07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15
                             -.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27
                             .68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12
                             .51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48
                             0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
                </svg>
                GitHub
            </a>
        </div>
    </div>

    <div class="feature-grid" style="margin: 0 auto;">
        <div class="card feature-card animate-in animate-in-delay-1">
            <div class="feature-icon">🌌</div>
            <div class="feature-title">From Photos to a 3D Scene</div>
            <div class="feature-desc">
                Overlapping photos from different positions become one 3D scene. Learned feature matching
                finds the cameras; training fits millions of Gaussian splats to your photos.
            </div>
        </div>

        <div class="card feature-card animate-in animate-in-delay-2">
            <div class="feature-icon">⚡</div>
            <div class="feature-title">GPU-First, Real-Time</div>
            <div class="feature-desc">
                Matching, camera solving, training and rendering all run on your GPU through WebGPU.
                Trained scenes render at interactive frame rates.
            </div>
        </div>

        <div class="card feature-card animate-in animate-in-delay-3">
            <div class="feature-icon">🔒</div>
            <div class="feature-title">Entirely In Your Browser</div>
            <div class="feature-desc">
                No server. No cloud. No uploads. Your photos never leave your device.
                Projects save locally and persist across sessions.
            </div>
        </div>

        <div class="card feature-card animate-in animate-in-delay-4">
            <div class="feature-icon">🥽</div>
            <div class="feature-title">Built for Immersion</div>
            <div class="feature-desc">
                The whole interface is drawn on the GPU, so it works in a headset as it does on a desktop.
                Step into your scenes with WebXR VR and AR where your device supports them.
            </div>
        </div>
    </div>

    <div class="pipeline-section animate-in animate-in-delay-5">
        <h3 class="pipeline-title">How It Works</h3>
        <div class="pipeline-steps">
            <a href="/studio" class="pipeline-step step-ready">
                <div class="step-number">1</div>
                <div class="step-content">
                    <div class="step-name">Add Photos</div>
                    <div class="step-desc">Many overlapping shots of one place, or a single photo</div>
                </div>
                <div class="step-arrow">→</div>
            </a>

            <a href="/studio" class="pipeline-step step-ready">
                <div class="step-number">2</div>
                <div class="step-content">
                    <div class="step-name">Find the Cameras</div>
                    <div class="step-desc">Learned matching and structure from motion on your GPU</div>
                </div>
                <div class="step-arrow">→</div>
            </a>

            <a href="/studio" class="pipeline-step step-ready">
                <div class="step-number">3</div>
                <div class="step-content">
                    <div class="step-name">Train the Scene</div>
                    <div class="step-desc">Gaussian splats fitted to your photos, on your GPU</div>
                </div>
                <div class="step-arrow">→</div>
            </a>

            <a href="/studio" class="pipeline-step step-ready">
                <div class="step-number">4</div>
                <div class="step-content">
                    <div class="step-name">Explore in 3D</div>
                    <div class="step-desc">Walk through it, or step in with VR and AR</div>
                </div>
            </a>
        </div>
    </div>

    <div style="text-align: center; margin: var(--space-2xl) 0 var(--space-xl);" class="animate-in animate-in-delay-5">
        <h3 style="color: var(--text-primary); margin-bottom: var(--space-sm);">The Vision</h3>
        <p style="color: var(--text-muted); max-width: 650px; margin: 0 auto; line-height: 1.7;">
            Point your phone at a room, and come back to it in 3D any time, from any device, in any browser,
            even in VR. SpawnScene already reconstructs scenes from your photos entirely on your own machine;
            next come video capture, collaborative scanning and fully immersive spatial computing, all
            client-side with zero infrastructure.
        </p>
    </div>

    <div class="tech-section animate-in animate-in-delay-6">
        <h3 class="tech-title">Built With</h3>
        <div class="tech-badges">
            <span class="tech-badge">Blazor WebAssembly</span>
            <span class="tech-badge">SpawnDev.SpawnJS</span>
            <span class="tech-badge">SpawnDev.ILGPU</span>
            <span class="tech-badge">SpawnDev.ILGPU.ML</span>
            <span class="tech-badge">SpawnDev.GameUI</span>
            <span class="tech-badge">WebGPU</span>
            <span class="tech-badge">.NET 10</span>
            <span class="tech-badge">C# 13</span>
        </div>
    </div>
</div>
