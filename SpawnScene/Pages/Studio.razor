@page "/studio"
@layout SpawnScene.Layout.StudioLayout
@using SpawnDev.SpawnJS
@using SpawnDev.SpawnJS.JSObjects
@using SpawnDev.GameUI
@using SpawnDev.GameUI.Elements
@using ILGPU
@using ILGPU.Runtime
@using SpawnDev.ILGPU.WebGPU
@implements IAsyncDisposable

<PageTitle>Studio — SpawnScene</PageTitle>

<div @ref="_containerRef" style="width:100vw;height:100vh;overflow:hidden;position:fixed;top:0;left:0;">
    <canvas @ref="_canvasRef"
            width="@_canvasWidth" height="@_canvasHeight"
            style="width:100%;height:100%;display:block;touch-action:none;"></canvas>
    @* touch-action:none - the viewer handles touch itself (TouchNavigator); without it the browser pinch-zoomed the
       page under a two-finger gesture, moving every touch coordinate and leaving a black, zoomed-in page. *@
    @* The GPU device is gone (GpuService.DeviceLostExplained): the canvas UI renders on that device, so this notice is
       plain HTML - nothing drawn on the canvas can appear any more. *@
    @if (_deviceLostText != null)
    {
        <div role="alert" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(10,12,16,0.82);z-index:10;">
            <div style="max-width:560px;margin:16px;padding:24px 28px;border-radius:10px;background:#1b1f27;border:1px solid #3a4150;color:#e6e9ef;font:15px/1.5 system-ui,-apple-system,'Segoe UI',sans-serif;">
                <div style="font-size:18px;font-weight:600;margin-bottom:10px;">The GPU was lost</div>
                <div style="color:#c3c9d4;">@_deviceLostText</div>
                <div style="margin-top:14px;color:#8d96a6;font-size:13px;">Saved projects are kept. Unsaved work in this tab is not.</div>
                <button @onclick="ReloadPage" style="margin-top:18px;padding:8px 18px;border:0;border-radius:6px;background:#3d7bfd;color:#fff;font:inherit;cursor:pointer;">Reload</button>
            </div>
        </div>
    }
    @* Hidden file input — browser security requires a real HTML element for file picking *@
    <InputFile @ref="_fileInput" OnChange="OnFileSelected" accept="image/*,video/*" multiple
               style="position:absolute;top:-9999px;left:-9999px;opacity:0;" />
    <InputFile @ref="_sceneInput" OnChange="OnSceneFileSelected" accept=".spawnscene,.ply,.spz,.splat,.sog"
               style="position:absolute;top:-9999px;left:-9999px;opacity:0;" />
</div>
