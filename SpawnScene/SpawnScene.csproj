<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
		<!-- Not compression needed -->
		<CompressionEnabled>false</CompressionEnabled>
		<!-- Disable IL trimming to preserve ILGPU kernel methods invoked via reflection -->
		<!--
		  Never treat build or intermediate output as project CONTENT.

		  The harness publishes with a private BaseIntermediateOutputPath (an open Visual Studio
		  otherwise stales the publish silently), and it publishes into bin/PublishRelease, which
		  lives under the project. Passing DefaultItemExcludes on the command line REPLACES the
		  SDK default list rather than adding to it, which drops the bin exclusion - and then the
		  publish output is content, so every publish copies the previous one into itself. That
		  reached 11 levels of nesting and 13 GB before anyone noticed it as "the publish is slow".
		  Appending here keeps the SDK defaults and needs no command-line flag.
		-->
		<DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
		<!-- AOT BY DEFAULT (TJ 2026-10-02). The managed SfM (five-point RANSAC, rotation averaging, dense triangulation, BA
		     host code) runs in the Mono interpreter otherwise. MEASURED on Bathroom, interpreter -> AOT: five-point 1.4 -> 0.2 s,
		     BA total 30.1 -> 19.5 s, import 66 -> 49 s, training 55.1 -> 59.6 it/s, identical results.
		     WasmStripILAfterAOT=false is REQUIRED: ILGPU compiles kernels from IL at runtime. Costs: dotnet.native.wasm is
		     53 MB (3 MB interpreted), and the build takes about an hour on one core. For a fast dev publish use
		     -p:SpawnSceneAot=false. -->
		<SpawnSceneAot Condition="'$(SpawnSceneAot)' == ''">true</SpawnSceneAot>
		<RunAOTCompilation>$(SpawnSceneAot)</RunAOTCompilation>
		<WasmStripILAfterAOT>false</WasmStripILAfterAOT>
		<!-- WASM AOT requires trimming (WasmApp.Common.targets: "AOT is not supported without IL trimming"). The SpawnDev
		     libraries are trim safe (2026-10-01); SpawnScene itself is rooted whole below (System.Text.Json project files). -->
		<PublishTrimmed>$(SpawnSceneAot)</PublishTrimmed>
	</PropertyGroup>
	<!-- GpuBundleAdjuster device precision: double unless built with -p:BaFloat=true (f32 A/B timing). -->
	<PropertyGroup Condition="'$(BaFloat)' == 'true'">
		<DefineConstants>$(DefineConstants);BA_FLOAT</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
		<PackageReference Include="SpawnDev.GameUI" Version="0.1.0-rc.6" />
		<PackageReference Include="SpawnDev.ILGPU.ML" Version="5.3.2" />
		<!-- Direct, ahead of ILGPU.ML's own reference: 5.2.18-local.2+ fixes WebGPU loop exits that skip code
		     (early return from nested loops), helpers taking LocalMemory views (GpuEpipolarRansac), and compiles one pipeline per kernel instead of one per dispatch size. local.3-.5 add WebGPUBufferAccounting (live buffers, creation sites). -->
		<PackageReference Include="SpawnDev.ILGPU" Version="5.3.3" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
		<PackageReference Include="SpawnDev.SpawnJS.Blazor" Version="3.0.2" />
	</ItemGroup>


	<!-- Prevent the IL trimmer from removing types accessed via reflection in ILGPU's static constructors -->
	<ItemGroup>
		<TrimmerRootAssembly Include="ILGPU" />
		<TrimmerRootAssembly Include="ILGPU.Algorithms" />
		<TrimmerRootAssembly Include="SpawnDev.ILGPU" />
		<TrimmerRootAssembly Include="SpawnScene" />
	</ItemGroup>


	<!-- Local UI/ superseded by SpawnDev.GameUI; keep files for history, do not compile. -->
	<ItemGroup>
		<Compile Remove="UI/**/*.cs" />
		<None Include="UI/**/*.cs" />
	</ItemGroup>
</Project>
